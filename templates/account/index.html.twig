{% extends 'base.html.twig' %}
{% block title %}Account{% endblock %}
{% block body %}
<h1>Account</h1>
<div class="card">
    <h2>API access</h2>
    {% if token %}
        <p>Copy your token now — it will not be shown again.</p>
        <p><code style="word-break:break-all">{{ token }}</code></p>
        <p class="muted">Use it as <code>Authorization: Bearer &lt;token&gt;</code>. Generating a new one revokes this one.</p>
    {% else %}
        <p class="muted">{{ hasToken ? 'You have an active token. Generating a new one revokes it.' : 'No token yet.' }}</p>
    {% endif %}
    <form method="post" action="{{ path('app_account_token') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('api-token') }}">
        <button type="submit">{{ hasToken ? 'Regenerate token' : 'Create API token' }}</button>
    </form>
    <p class="muted">API reference: <a href="/api/openapi.yaml">openapi.yaml</a></p>
</div>
{% endblock %}
