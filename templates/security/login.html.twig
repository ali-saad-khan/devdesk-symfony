{% extends 'base.html.twig' %}
{% block title %}Sign in{% endblock %}
{% block body %}
<div class="card" style="max-width:420px;margin:2rem auto">
    <h1>Sign in</h1>
    {% if error %}<div class="flash error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}
    <form method="post">
        <div class="row"><label for="username">Email</label><input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus></div>
        <div class="row"><label for="password">Password</label><input type="password" id="password" name="_password" autocomplete="current-password" required></div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <div class="row"><label style="font-weight:400"><input type="checkbox" name="_remember_me" checked> Keep me signed in</label></div>
        <button type="submit">Sign in</button>
    </form>
    <p class="muted">No account? <a href="{{ path('app_register') }}">Register</a></p>
</div>
{% endblock %}
