{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "excludeFiles": "{tests/**,docker/**,.github/**,docs/**,var/**}"
    }
  },
  "routes": [
    { "src": "^/(index\\.php)?$", "dest": "/api/index.php" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "crons": [
    { "path": "/cron/sla", "schedule": "0 6 * * *" }
  ]
}
